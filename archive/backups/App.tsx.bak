              )}
            </div>
            <div>
              <h2>{scan ? (scan.name ?? '? ìˆ˜ ë¶ˆëŸ¬??) : '? ìˆ˜ ?†ìŒ'}</h2>
              <p>UID {uid}</p>
            </div>
            <button type="button" className={activeFavorite ? 'favorite-button active' : 'favorite-button'} disabled={!scan} onClick={toggleFavorite}>
              <Star size={16} />
              {activeFavorite ? 'ì¦ê²¨ì°¾ê¸° ?´ì œ' : 'ì¦ê²¨ì°¾ê¸° ì¶”ê?'}
            </button>
            <div className="mini-grid">
              <span>CA / PA</span>
              <strong>{scan ? `${scan.ca} / ${scan.pa}` : '-'}</strong>
              <span>?íƒœ</span>
              <strong>{scan ? '?¸ì§‘ ê°€?? : '?€ê¸?}</strong>
            </div>
          </section>

          <nav className="section-nav">
            <NavButton icon={<Activity />} active={section === 'attributes'} label="?¥ë ¥ì¹? onClick={() => setSection('attributes')} />
            <NavButton icon={<Shield />} active={section === 'positions'} label="?¬ì??? onClick={() => setSection('positions')} />
            <NavButton icon={<Sparkles />} active={section === 'traits'} label="? í˜¸ ?Œë ˆ?? onClick={() => setSection('traits')} />
            <NavButton icon={<EyeOff />} active={section === 'private'} label="?¨ê? / ë¹„ê³µê°? onClick={() => setSection('private')} />
            <NavButton icon={<Search />} active={section === 'scouting'} label="?¤ì¹´?°íŒ…" onClick={() => setSection('scouting')} />
          </nav>

          <SavedPlayerList title="ì¦ê²¨ì°¾ê¸°" icon={<Star />} players={favoritePlayers} onSelect={openSavedPlayer} />
          <SavedPlayerList title="ìµœê·¼ ê²€?? icon={<Clock3 />} players={recentPlayers} onSelect={openSavedPlayer} />
        </aside>

        <section className="editor-surface">
          {section === 'attributes' && <AttributesView groups={fieldsByCategory} values={values} onChange={stageChange} />}
          {section === 'positions' && <PositionsView values={values} onChange={stageChange} />}
          {section === 'traits' && <TraitsView values={values} onChange={stageChange} />}
          {section === 'private' && (
            <PrivateView fields={fieldsByCategory.hidden} revealed={revealedPrivate} values={values} onReveal={revealField} onChange={stageChange} />
          )}
          {section === 'scouting' && (
            <ScoutingView
              teamName={scoutTeamName}
              clubId={scoutClubId}
              squadKind={scoutSquad}
              knowledgeLevel={scoutLevel}
              uids={scoutUids}
              report={scoutReport}
              busy={busy}
              onTeamNameChange={setScoutTeamName}
              onClubIdChange={setScoutClubId}
              onSquadKindChange={setScoutSquad}
              onKnowledgeLevelChange={setScoutLevel}
              onUidsChange={setScoutUids}
              onCollect={collectClubUids}
              onBuild={buildScoutingReport}
            />
          )}
        </section>

        <aside className="changes-panel">
          <div className="panel-heading">
            <ListChecks size={18} />
            <h2>ë³€ê²??€ê¸?/h2>
          </div>
          {changes.length === 0 ? (
            <p className="empty-state">?„ì§ ë³€ê²½ëœ ??ª©???†ìŠµ?ˆë‹¤.</p>
          ) : (
            <ul className="change-list">
              {changes.map((change) => (
                <li key={change.key}>
                  <span>{change.label}</span>
                  <strong>
                    {formatChange(change.from)} ??{formatChange(change.to)}
                  </strong>
