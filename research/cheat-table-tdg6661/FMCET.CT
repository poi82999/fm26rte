                    <CheatEntry>
                      <ID>12674</ID>
                      <Description>"Extend Contract Length by X Years"</Description>
                      <Color>DCDCDC</Color>
                      <VariableType>Auto Assembler Script</VariableType>
                      <AssemblerScript>{$lua}
if syntaxcheck then return end

[ENABLE]
local function _updateFunc()
  local Person = readQword('ptrPerson')
  if Person == nil or Person == 0 or not isPerson(Person) then return end

  local value = tonumber(inputQuery("Enter Value","Number of years:",""))
  local option = 1 -- 1: Set Contract Start Date to Current Date;
                   -- 2: Set Future Contract Start Date to Current Date (to prevent interest from other clubs)

  if not isnumber(value) then return end
  return extendPersonContract('ptrPerson', value, option)
end

_updateFunc()
enableAutoDisable(memrec, nil) 
[DISABLE]
</AssemblerScript>
