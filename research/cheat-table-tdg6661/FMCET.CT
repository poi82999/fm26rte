            <CheatEntry>
              <ID>12109</ID>
              <Description>"Savegame Check"</Description>
              <Options moActivateChildrenAsWell="1" moDeactivateChildrenAsWell="1"/>
              <Color>00FFFF</Color>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>{$lua}
if syntaxcheck then return end
[ENABLE]
local t = createTimer()
t.Interval = 100
t.OnTimer = function()
  local addr = readQword('dbtRoot')
  if addr ~= nil and addr ~= 0 then
    t.Enabled = false
    t.Destroy()

    if checkSavedGame() then
      getAddressList().getMemoryRecordByID(23688).Active = true
      return
    else
      MessageDialog('First Check', 'Savegame Not Found.\n\nPlease load a saved game for the first time then try again.', 0)
      rootMemrec.Active = false
      return
    end
  end
end

t.Enabled = true
[DISABLE]

</AssemblerScript>
