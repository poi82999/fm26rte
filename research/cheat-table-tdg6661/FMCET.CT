                    <CheatEntry>
                      <ID>17989</ID>
                      <Description>"Improve Hidden Attributes"</Description>
                      <Color>DCDCDC</Color>
                      <VariableType>Auto Assembler Script</VariableType>
                      <AssemblerScript>{$lua}
if syntaxcheck then return end
[ENABLE]
local function _updateFunc()
  local Player = readQword('ptrPlayer')
  if Player == nil or Player == 0 then return end

  Player = getPlayerData()

  if tonumber(Player.Determination.Value) &lt; 12 then
	Player.Determination.Value = math.random(12,19)
  end

  if tonumber(Player.Consistency.Value) &lt; 12 then
	Player.Consistency.Value = math.random(12,19)
  end

  if tonumber(Player.ImportantMatches.Value) &lt; 12 then
	Player.ImportantMatches.Value = math.random(12,19)
  end

  if tonumber(Player.InjuryProness.Value) &gt; 9 then
	Player.InjuryProness.Value = math.random(1,9)
  end
end

_updateFunc()
enableAutoDisable(memrec, nil) 
[DISABLE]
</AssemblerScript>
