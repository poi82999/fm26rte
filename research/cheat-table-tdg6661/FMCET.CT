                <CheatEntry>
                  <ID>18023</ID>
                  <Description>"Appereance - All Corners/All Seated/Roof"</Description>
                  <Color>DCDCDC</Color>
                  <VariableType>Auto Assembler Script</VariableType>
                  <AssemblerScript>{$lua}
if syntaxcheck then return end

[ENABLE]
local function _updateFunc()
   local Stadium = readQword("ptrStadium")
   if Stadium == nil or Stadium == 0 then return end

   local Capacity = tonumber(getAddressList().getMemoryRecordByID(17317).Value)

   getAddressList().getMemoryRecordByID(17318).Value = Capacity

   local Main = (Capacity * 0.5) / 2
   local Side = (Capacity * 0.25) / 2
   local Corner = (Capacity * 0.25) / 4

   getAddressList().getMemoryRecordByID(17223).Value = Main               -- Top Stand
   getAddressList().getMemoryRecordByID(17235).Value = Main               -- Bottom Stand
   getAddressList().getMemoryRecordByID(17247).Value = Side               -- Right Stand
   getAddressList().getMemoryRecordByID(17259).Value = Side               -- Left Stand
   getAddressList().getMemoryRecordByID(17271).Value = Corner             -- Top Right Stand
   getAddressList().getMemoryRecordByID(17283).Value = Corner             -- Bottom Right Stand
   getAddressList().getMemoryRecordByID(17295).Value = Corner             -- Top Left Stand
   getAddressList().getMemoryRecordByID(17307).Value = Corner             -- Bottom Left Stand

   local listID = { 17226, 17227, 17229, 17230, 17238, 17239, 17241, 17242, 17250, 17251, 17253, 17254, 17262, 17263, 17265, 17266, 17274, 17275, 17277, 17278, 17286, 17287, 17289, 17290, 17298, 17299, 17301, 17302, 17310, 17311, 17313, 17314 }
   changeRecordsValue(listID, 1)
   listID = { 17231, 17232, 17243, 17244, 17255, 17256, 17267, 17268, 17279, 17280, 17291, 17292, 17303, 17304, 17315, 17316 }
   changeRecordsValue(listID, 0)
end

_updateFunc()
enableAutoDisable(memrec, nil) 
[DISABLE]
