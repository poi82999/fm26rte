              <AssemblerScript>{$lua}
if syntaxcheck then return end
[ENABLE]
local _updateFunc = function()
  local count = 0

  cls()
  print('People Flagged as Freeze Attributes:\n-------------------------------')
  forEach(PersonTableStart, PersonTableEnd, 0x8, function(k, elemAddr)
    if count == Table.MaxShowItem then return end

    local Person = readQword(elemAddr)
    if Person == nil or Person == 0 or not isPerson(Person) then return end

    if readBit(Person+pero.Pfl2, 5) == 1 then
      print(string.format('%d. %s (ID: %d)', count+1, getObjectName(Person), readInteger(Person+0xC)))
      count = count + 1
    end
  end)
  print('\nTotal:', count)
end

_updateFunc()
