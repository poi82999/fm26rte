        <CheatEntry>
          <ID>3000</ID>
          <Description>"Nation &gt;"</Description>
          <Options moHideChildren="1" moDeactivateChildrenAsWell="1"/>
          <Color>FF8080</Color>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>{$lua}
if syntaxcheck then return end
[ENABLE]
local Nefr = getAddressList().getMemoryRecordByID(18095) -- Nations Treated as EU
local Nnfr = getAddressList().getMemoryRecordByID(13044) -- Nations Treated as Non-Foreign
local Nrvn = getAddressList().getMemoryRecordByID(24267) -- Rival Nations
local Nlns = getAddressList().getMemoryRecordByID(24268) -- Languages
local C1sq = getAddressList().getMemoryRecordByID(3006)  -- Teams
local TCrs = getAddressList().getMemoryRecordByID(13043) -- Responsibilities

local _updateName = function()
  local object = readQword('ptrNation')
  if object == nil or object == 0 then memrec.Description = "Nation &gt; &lt;N/A&gt;" return end

  local name = getObjectName(object)
  local uid = readInteger(object+objo.Duni)

  memrec.Description = string.format("Nation &gt; %s (ID: %d)", name, uid)
  ---
  updateFixtureRulesRecords(memrec, object+nato.Adva)
  updateWorkPermitRulesRecords(memrec, object+nato.Adva)
  updatePersonArray(memrec, 'Coaching Staff', '[ptrNation]+78', '[ptrNation]+80')
  Nefr.Address = 1
  Nnfr.Address = 1
  Nrvn.Address = 1
  Nlns.Address = 1
  ---
  if C1sq.Active then
      local addr = getAddressSafe(readQword('ptrNation')+nato.Ntct)
      enableTeamRecords(memrec, addr)
  end
  if TCrs.Active then
	  enableResponsibilityRecords(TCrs, 'ptrNation')
  end
end

local _updateFunc = function()
  if memrec ~= nil and memrec.Active then
	if readInteger('updNation') == 1 then
	  writeInteger('updNation', 0)
	  _updateName()
	end
  end
end

_updateName()
memrec.Color = Color.SwitchOn
enableTimer(memrec, Table.HeaderUpdateTime, _updateFunc)

[DISABLE]
memrec.Color = Color.Header
if memrec ~= nil then
  memrec.Description = "Nation &gt;"
end
</AssemblerScript>
