          <ID>17204</ID>
          <Description>"Stadium &gt;"</Description>
          <Options moHideChildren="1" moDeactivateChildrenAsWell="1"/>
          <Color>FF8080</Color>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>{$lua}
if syntaxcheck then return end
[ENABLE]
local _updateName = function()
  local object = readQword('ptrStadium')
  if object == nil or object == 0 then memrec.Description = "Stadium &gt; &lt;N/A&gt;" return end

  local name = getObjectName(object)
  local uid = readInteger(object+objo.Duni)

  memrec.Description = string.format("Stadium &gt; %s (ID: %d)", name, uid)
end

local _updateFunc = function()
  if memrec ~= nil and memrec.Active then
	if readInteger('updStadium') == 1 then
	  writeInteger('updStadium', 0)
	  _updateName()
	end
  end
end

_updateName()
memrec.Color = Color.SwitchOn
enableTimer(memrec, Table.HeaderUpdateTime, _updateFunc)

[DISABLE]
memrec.Color = Color.Header
if memrec ~= nil then
  memrec.Description = "Stadium &gt;"
end
</AssemblerScript>
          <CheatEntries>
            <CheatEntry>
