                <CheatEntry>
                  <ID>19966</ID>
                  <Description>"Stadium Setting - Grass/Synthetic Mix/Very Good/Has Digital Ad Hoarding"</Description>
                  <Color>DCDCDC</Color>
                  <VariableType>Auto Assembler Script</VariableType>
                  <AssemblerScript>{$lua}
if syntaxcheck then return end
[ENABLE]
local function _updateFunc()
  local Stadium = readQword("ptrStadium")
  if Stadium == nil or Stadium == 0 then return end

  local Capacity = readInteger(Stadium+stao.Scpy)

  writeInteger(Stadium+stao.Scpy+0x4, Capacity)
  writeInteger(Stadium+stao.Scpy+0x8, Capacity)
  writeInteger(Stadium+stao.Scpy+0xC, Capacity)
  if readBytes(Stadium+stao.Soty) == 1 then
  writeInteger(Stadium+stao.Scpy+0x10, Capacity+(Capacity*0.25))
  end

  getAddressList().getMemoryRecordByID(17352).Value  = 1
  getAddressList().getMemoryRecordByID(17363).Value  = 1
  getAddressList().getMemoryRecordByID(17322).Value  = 8
end

_updateFunc()
enableAutoDisable(memrec, nil) 
[DISABLE]


