    <CheatEntry>
      <ID>0</ID>
      <Description>"Run Table"</Description>
      <Options moAlwaysHideChildren="1"/>
      <Color>00D7FF</Color>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>[ENABLE]
{$lua}
if syntaxcheck then return end
rootMemrec = memrec
openProcess(expectedExecutable)
local valid = startUpValidation(rootMemrec)
if valid then runEngine(rootMemrec) end
{$asm}

alloc(datPointerList, $1000)

label(ptrSelectedObj)
label(ptrAward)
label(ptrCity)
label(ptrClub)
label(ptrComp)
label(ptrContinent)
label(ptrDerby)
label(ptrFullContract)
label(ptrHumanStaff)
label(ptrLeagueStage)
label(ptrLoanContract)
label(ptrNation)
label(ptrNationContract)
label(ptrPerson)
label(ptrPlayer)
label(ptrRevClubContract)
label(ptrStadium)
label(ptrStaff)
label(ptrTeam)

label(updSelect)
label(updAward)
label(updCity)
label(updClub)
label(updComp)
label(updContinent)
label(updDerby)
label(updNation)
label(updPerson)
label(updStadium)
label(updTeam)

label(ptrRCA)

registersymbol(ptrSelectedObj)
registersymbol(ptrAward)
registersymbol(ptrCity)
registersymbol(ptrClub)
registersymbol(ptrComp)
registersymbol(ptrContinent)
registersymbol(ptrDerby)
registersymbol(ptrFullContract)
registersymbol(ptrHumanStaff)
registersymbol(ptrLeagueStage)
registersymbol(ptrLoanContract)
registersymbol(ptrNation)
registersymbol(ptrNationContract)
registersymbol(ptrPerson)
registersymbol(ptrPlayer)
registersymbol(ptrRevClubContract)
registersymbol(ptrStadium)
registersymbol(ptrStaff)
registersymbol(ptrTeam)

registersymbol(updSelect)
registersymbol(updAward)
registersymbol(updCity)
registersymbol(updClub)
registersymbol(updComp)
registersymbol(updContinent)
registersymbol(updDerby)
registersymbol(updNation)
registersymbol(updPerson)
registersymbol(updStadium)
registersymbol(updTeam)

registersymbol(ptrRCA)

datPointerList:
ptrSelectedObj:
  dq 0
ptrAward:
  dq 0
ptrCity:
  dq 0
ptrClub:
  dq 0
ptrComp:
  dq 0
ptrContinent:
  dq 0
ptrDerby:
  dq 0
ptrFullContract:
  dq 0
ptrHumanStaff:
  dq 0
ptrLeagueStage:
  dq 0
ptrLoanContract:
  dq 0
ptrNationContract:
  dq 0
ptrNation:
  dq 0
ptrPerson:
  dq 0
ptrPlayer:
  dq 0
ptrRevClubContract:
  dq 0
ptrStaff:
  dq 0
ptrTeam:
  dq 0
ptrStadium:
  dq 0

updSelect:
  dd 0
updAward:
  dd 0
updClub:
  dd 0
updCity:
  dd 0
updComp:
  dd 0
updContinent:
  dd 0
updDerby:
  dd 0
updNation:
  dd 0
updPerson:
  dd 0
updTeam:
  dd 0
updStadium:
  dd 0

ptrRCA:
  dd 0

[DISABLE]
{$lua}
if syntaxcheck then return end
_deactivateTimers = true
disableAllRecords(memrec, false)
showStatusPanel(nil)
SearchPanel.Visible = false
memrec.options = "[moAlwaysHideChildren]"
{$asm}
unregistersymbol(*)
dealloc(*)
</AssemblerScript>
      <CheatEntries>
        <CheatEntry>
          <ID>2</ID>
          <Description>"============================================================================================="</Description>
          <Color>808080</Color>
          <GroupHeader>1</GroupHeader>
        </CheatEntry>
        <CheatEntry>
          <ID>16899</ID>
          <Description>"Search &gt;"</Description>
          <Options moHideChildren="1"/>
          <Color>C080FF</Color>
          <GroupHeader>1</GroupHeader>
        </CheatEntry>
        <CheatEntry>
          <ID>16896</ID>
          <Description>"============================================================================================="</Description>
          <Color>808080</Color>
          <GroupHeader>1</GroupHeader>
        </CheatEntry>
        <CheatEntry>
          <ID>17652</ID>
          <Description>"Award &gt;"</Description>
          <Options moHideChildren="1" moDeactivateChildrenAsWell="1"/>
          <Color>FF8080</Color>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>{$lua}
if syntaxcheck then return end
[ENABLE]
local _updateName = function()
  local object = readQword('ptrAward')
  if object == nil or object == 0 then memrec.Description = "Award &gt; &lt;N/A&gt;" return end

  local name = getObjectName(object)
  local uid = readInteger(object+objo.Duni)

  memrec.Description = string.format("Award &gt; %s (ID: %d)", name, uid)
end

local _updateFunc = function()
  if memrec ~= nil and memrec.Active then
	if readInteger('updAward') == 1 then
	  writeInteger('updAward', 0)
	  _updateName()
	end
  end
end

_updateName()
memrec.Color = Color.SwitchOn
enableTimer(memrec, Table.HeaderUpdateTime, _updateFunc)

[DISABLE]
memrec.Color = Color.Header
if memrec ~= nil then
  memrec.Description = "Award &gt;"
end
</AssemblerScript>
