if syntaxcheck then return end
[ENABLE]
local _updateFunc = function()
  showStatusPanel(Table.ShowStatusPanel)

  updateSampleColorRecords()

  local rec = getAddressList()
  if rec.getCount() ~= Table.mrTotal then
    Table.mrTotal = rec.getCount()
  end

  if ScoutingTool.Visible then
	  loadPlayerData('ptrPerson')
  end

  mgrClubPtr = getManagerClub() or 0
  mgrClubUID = getManagerClubUID() or 0
  mgrCompUID = getManagerCompUID() or 0
end

enableTimer(memrec, Table.TimerUpdateTime, _updateFunc)
[DISABLE]
</AssemblerScript>
            </CheatEntry>
            <CheatEntry>
              <ID>23688</ID>
              <Description>"Update Global Pointers"</Description>
              <Options moActivateChildrenAsWell="1" moDeactivateChildrenAsWell="1"/>
              <Color>00FFFF</Color>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>{$lua}
if syntaxcheck then return end
[ENABLE]
local upd = false

local _updateFunc = function()
  -- Database Table
  local dbtRoot = readQword('dbtRoot')
  if dbtRoot ~= nil and dbtRoot ~= 0 then
    AwardTable               = readQword('[dbtRoot]+80')
    AwardTableStart          = readQword(AwardTable)
    AwardTableEnd            = readQword(AwardTable+0x8)

    CityTable                = readQword('[dbtRoot+8]+80')
    CityTableStart           = readQword(CityTable)
    CityTableEnd             = readQword(CityTable+0x8)

    ClubTable                = readQword('[dbtRoot+10]+80')
    ClubTableStart           = readQword(ClubTable)
    ClubTableEnd             = readQword(ClubTable+0x8)

    CompTable                = readQword('[dbtRoot+18]+80')
    CompTableStart           = readQword(CompTable)
    CompTableEnd             = readQword(CompTable+0x8)

    ContinentTable           = readQword('[dbtRoot+20]+80')
    ContinentTableStart      = readQword(ContinentTable)
    ContinentTableEnd        = readQword(ContinentTable+0x8)

    CurrencyTable            = readQword('[dbtRoot+30]+80')
    CurrencyTableStart       = readQword(CurrencyTable)
    CurrencyTableEnd         = readQword(CurrencyTable+0x8)

    DerbyTable               = readQword('[dbtRoot+B0]+80')
    DerbyTableStart          = readQword(DerbyTable)
    DerbyTableEnd            = readQword(DerbyTable+0x8)

    LanguageTable            = readQword('[dbtRoot+50]+80')
    LanguageTableStart       = readQword(LanguageTable)
    LanguageTableEnd         = readQword(LanguageTable+0x8)

    NationTable              = readQword('[dbtRoot+28]+80')
    NationTableStart         = readQword(NationTable)
    NationTableEnd           = readQword(NationTable+0x8)

    NationalTeaContTable     = readQword('[dbtRoot+60]+80')
    NationalTeaContTableStart= readQword(NationalTeaContTable)
    NationalTeaContTableEnd  = readQword(NationalTeaContTable+0x8)

    PersonTable              = readQword('[dbtRoot+68]+80')
    PersonTableStart         = readQword(PersonTable)
    PersonTableEnd           = readQword(PersonTable+0x8)

    RegionTable              = readQword('[dbtRoot+78]+80')
    RegionTableStart         = readQword(RegionTable)
    RegionTableEnd           = readQword(RegionTable+0x8)

    StadiumTable             = readQword('[dbtRoot+80]+80')
    StadiumTableStart        = readQword(StadiumTable)
    StadiumTableEnd          = readQword(StadiumTable+0x8)

    StadiumChangeTable       = readQword('[dbtRoot+88]+80')
    StadiumChangeTableStart  = readQword(StadiumChangeTable)
    StadiumChangeTableEnd    = readQword(StadiumChangeTable+0x8)

    TeamTable                = readQword('[dbtRoot+98]+80')
    TeamTableStart           = readQword(TeamTable)
    TeamTableEnd             = readQword(TeamTable+0x8)

    AgreementTable           = readQword('[dbtRoot+B8]+80')
    AgreementTableStart      = readQword(AgreementTable)
    AgreementTableEnd        = readQword(AgreementTable+0x8)
  end

  local mgrTransfer = readQword('mgrTransfer')
  if mgrTransfer ~= nil and mgrTransfer ~= 0 then
    TransferTableStart       = readQword(mgrTransfer+0x20)
    TransferTableEnd         = readQword(mgrTransfer+0x28)
    TransferDateTableStart   = readQword(mgrTransfer+0x50)
    TransferDateTableEnd     = readQword(mgrTransfer+0x58)
  end

  local mgrHumanNonPlayer = readQword('mgrHumanNonPlayer')
  if mgrHumanNonPlayer ~= nil and mgrHumanNonPlayer ~= 0 then
    HumanNonPlayerTableStart = readQword(mgrHumanNonPlayer+0x18)
    HumanNonPlayerTableEnd   = readQword(mgrHumanNonPlayer+0x20)
  end

  local mgrHallOfFame = readQword('mgrHallOfFame')
  if mgrHallOfFame ~= nil and mgrHallOfFame ~= 0 then
    HallOfFameTableStart     = readQword(mgrHallOfFame+0x18)
    HallOfFameTableEnd       = readQword(mgrHallOfFame+0x20)
  end

  local mgrRetirement = readQword('mgrRetirement')
  if mgrRetirement ~= nil and mgrRetirement ~= 0 then
    RetirementTableStart     = readQword(mgrRetirement+0x30)
    RetirementTableEnd       = readQword(mgrRetirement+0x38)
  end

  -- VTables
  if not pointerInitState or not checkExeMD5() then
    pointerInit()

    vtbAgreement             = getAddressSafe('vtbAgreement')
    vtbAward                 = getAddressSafe('vtbAward')
    vtbCity                  = getAddressSafe('vtbCity')
    vtbClub                  = getAddressSafe('vtbClub')
    vtbCompetition           = getAddressSafe('vtbCompetition')
    vtbContinent             = getAddressSafe('vtbContinent')
    vtbDerby                 = getAddressSafe('vtbDerby')
    vtbNation                = getAddressSafe('vtbNation')
    vtbNationalTeam          = getAddressSafe('vtbNationalTeam')
    vtbNationalTeaCont       = getAddressSafe('vtbNationalTeaCont')
    vtbNonPlayer             = getAddressSafe('vtbNonPlayer')
    vtbPlayer                = getAddressSafe('vtbPlayer')
    vtbPlayerStaff           = getAddressSafe('vtbPlayerStaff')
    vtbRegion                = getAddressSafe('vtbRegion')
    vtbStadium               = getAddressSafe('vtbStadium')
    vtbTeam                  = getAddressSafe('vtbTeam')
    vtbHumanNonPlayer        = getAddressSafe('vtbHumanNonPlayer')
    vtbRetiredPerson         = getAddressSafe('vtbRetiredPerson')
    vtbLeagueStage           = getAddressSafe('vtbLeagueStage')
  end

  if not upd then
    getAddressList().getMemoryRecordByID(1).Active = true
    getAddressList().getMemoryRecordByID(24269).Active = true
    upd = true
  end
end

enableTimer(memrec, 120000, _updateFunc)
[DISABLE]

</AssemblerScript>
            </CheatEntry>
            <CheatEntry>
              <ID>1</ID>
              <Description>"Update On Focus Change or Hover Tooltip"</Description>
              <Color>00FFFF</Color>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>[ENABLE]
aobscanmodule(getObjectPointer, $expectedModule, 89 D6 48 89 CF 49 8B 00 48 8D 54)
alloc(newmem,$1000,getObjectPointer)
registersymbol(getObjectPointer)
label(return)

newmem:

fnMain:
  mov esi,edx
  mov rdi,rcx

  push r14           // backup and replace r14 as selected object
  mov r14, r8
  jmp fnObjectSelector

fnObjectSelector:
  // r14 has selected object
  push rax
  push rbx
  push rcx
  push rsi
  push r15

  mov [ptrSelectedObj],r14
  mov rcx,[r14]

  mov rsi, vtbPlayer
  cmp rcx, rsi
  je selPerson

  mov rsi, vtbNonPlayer
  cmp rcx, rsi
  je selPerson

  mov rsi, vtbPlayerStaff
  cmp rcx, rsi
  je selPerson

  mov rsi, vtbHumanNonPlayer
  cmp rcx, rsi
  je selPerson

  mov rsi, vtbClub
  cmp rcx, rsi
  je selClub

  mov rsi, vtbCompetition
  cmp rcx, rsi
  je selComp

  mov rsi, vtbContinent
  cmp rcx, rsi
  je selContinent

  mov rsi, vtbNation
  cmp rcx, rsi
  je selNation

  mov rsi, vtbStadium
  cmp rcx, rsi
  je selStadium

  mov rsi, vtbTeam
  cmp rcx, rsi
  je selTeam

  mov rsi, vtbNationalTeam
  cmp rcx, rsi
  je selNationalTeam

  mov rsi, vtbNationalTeaCont
  cmp rcx, rsi
  je selNationalTeaCont

  jmp doneSelect

selClub:
  mov [ptrClub],r14
  mov [updClub],1
  mov rsi, [r14+18]
  mov rsi, [rsi]
  mov [ptrTeam], rsi
  mov [updTeam], 1
  cmp [rsi+78],0
  je doneSelect
  mov rsi, [rsi+78]
  mov [ptrStadium],rsi
  mov [updStadium],1
  jmp doneSelect

selComp:
  mov [ptrComp], r14
  mov [updComp], 1

  mov rsi,$cmpo.Cacm
  cmp [r14+rsi],0
  je doneSelect

  mov r15,[r14+rsi]
  mov rsi,$cmpo.Clge
  cmp [r15+rsi],0
  je doneSelect

  mov r15,[r15+rsi]
  mov r15,[r15]
  mov [ptrLeagueStage], r15
  jmp doneSelect

selContinent:
  mov [ptrContinent], r14
  mov [updContinent], 1
  jmp doneSelect

selNation:
  mov [ptrNation], r14
  mov [updNation], 1
  jmp doneSelect

selStadium:
  mov [ptrStadium], r14
  mov [updStadium], 1
  jmp doneSelect

selTeam:
  mov [ptrTeam], r14
  mov [updTeam], 1
  mov rsi, [r14+$teao.Tclu]
  mov [ptrClub],rsi
  mov [updClub],1
  jmp doneSelect

selNationalTeam:
  mov rsi, [r14+$teao.Tclu]
  mov rsi, [rsi+$nato.Nnat]
  mov [ptrNation], rsi
  mov [updNation], 1
  jmp doneSelect

selNationalTeaCont:
  mov rsi, [r14+$nato.Nnat]
  mov [ptrNation], rsi
  mov [updNation], 1
  jmp doneSelect

selPerson:
  // get the person offset from the person offset area
  mov rbx, r14
  mov rax, rbx
  mov rcx, [rbx]
  mov rcx, [rcx-8]
  mov ebx, [rcx+4]
  sub rax, ebx
  cmp ebx, $playerOffset        // offset sized used by player
  je selplr
  cmp ebx, $playerStaffOffset   // offset sized used by player / coach
  je selplrcch
  cmp ebx, $staffOffset         // offset sized used by staff
  je selstaff
  cmp ebx, $humanManagerOffset  // offset sized used by manager
  je selmgr
  jmp doneSelect
selplr:
  mov [ptrPlayer],rax
  mov qword ptr [ptrStaff],0
  mov qword ptr [ptrHumanStaff],0
  mov [ptrPerson], r14
  mov [updPerson], 1
  jmp doneSelect
selmgr:
  mov qword ptr [ptrPlayer],0
  mov [ptrStaff],rax
  mov [ptrHumanStaff],rax
  mov [ptrPerson], r14
  mov [updPerson], 1
  jmp doneSelect
selplrcch:
  // player coach attrs are person - 0xE0 or player + 1C8 - 8
  mov [ptrPlayer],rax
  add rax, $playerOffset
  sub rax, 8
  mov [ptrStaff],rax
  mov qword ptr [ptrHumanStaff],0
  mov [ptrPerson], r14
  mov [updPerson], 1
  jmp doneSelect
selstaff:
  //sub rax, 8
  mov [ptrStaff],rax
  mov qword ptr [ptrPlayer],0
  mov qword ptr [ptrHumanStaff],0
  mov [ptrPerson], r14
  mov [updPerson], 1
  jmp doneSelect

doneSelect:
  pop r15
  pop rsi
  pop rcx
  pop rbx
  pop rax
  pop r14
  ret  // return requires matching all

getObjectPointer:
  call fnMain
return:

LuaCall(updateManagerPointers())
[DISABLE]
getObjectPointer:
  db 89 D6 48 89 CF

unregistersymbol(getObjectPointer)
dealloc(newmem)

