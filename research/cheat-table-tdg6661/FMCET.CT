        <CheatEntry>
          <ID>19860</ID>
          <Description>"Continent &gt;"</Description>
          <Options moHideChildren="1" moDeactivateChildrenAsWell="1"/>
          <Color>FF8080</Color>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>{$lua}
if syntaxcheck then return end
[ENABLE]
local _updateName = function()
  local object = readQword('ptrContinent')
  if object == nil or object == 0 then memrec.Description = "Continent &gt; &lt;N/A&gt;" return end

  local name = getObjectName(object)
  local uid = readInteger(object+objo.Duni)

  memrec.Description = string.format("Continent &gt; %s (ID: %d)", name, uid)
  ---
  updateFixtureRulesRecords(memrec, object+cono.Adva)
end

local _updateFunc = function()
  if memrec ~= nil and memrec.Active then
	if readInteger('updContinent') == 1 then
	  writeInteger('updContinent', 0)
	  _updateName()
	end
  end
end

_updateName()
memrec.Color = Color.SwitchOn
enableTimer(memrec, Table.HeaderUpdateTime, _updateFunc)

[DISABLE]
memrec.Color = Color.Header
if memrec ~= nil then
  memrec.Description = "Continent &gt;"
end
</AssemblerScript>
