        <CheatEntry>
          <ID>19666</ID>
          <Description>"City &gt;"</Description>
          <Options moHideChildren="1" moDeactivateChildrenAsWell="1"/>
          <Color>FF8080</Color>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>{$lua}
if syntaxcheck then return end
[ENABLE]
local _updateName = function()
  local object = readQword('ptrCity')
  if object == nil or object == 0 then memrec.Description = "City &gt; &lt;N/A&gt;" return end

  local name = getObjectName(object)
  local uid = readInteger(object+objo.Duni)

  memrec.Description = string.format("City &gt; %s (ID: %d)", name, uid)
end

local _updateFunc = function()
  if memrec ~= nil and memrec.Active then
	if readInteger('updCity') == 1 then
	  writeInteger('updCity', 0)
	  _updateName()
	end
  end
end

_updateName()
memrec.Color = Color.SwitchOn
enableTimer(memrec, Table.HeaderUpdateTime, _updateFunc)

[DISABLE]
memrec.Color = Color.Header
if memrec ~= nil then
  memrec.Description = "City &gt;"
end
</AssemblerScript>
