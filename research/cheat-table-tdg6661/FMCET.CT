[ENABLE]
local _updateFunc = function()
  local Manager = readQword('ptrHumanStaff')
  if Manager == nil or Manager == 0 then return end

  local Person = getPersonFromPlayer(Manager)
  if Person == nil or Person == 0 then return end

  local Club = getPersonClub(Person)
  if Club == nil or Club == 0 then return end

  addClubToFreezer(Club, 19896, true)
end

