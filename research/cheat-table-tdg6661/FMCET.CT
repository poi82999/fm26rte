        <CheatEntry>
          <ID>19896</ID>
          <Description>"Freezer &gt;"</Description>
          <Options moHideChildren="1"/>
          <Color>C080FF</Color>
          <GroupHeader>1</GroupHeader>
          <CheatEntries>
            <CheatEntry>
              <ID>19898</ID>
              <Description>"Freezer (Off)"</Description>
              <Color>0000FF</Color>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>{
  Available Presets:

  clubNoTransferActivity(Club, false)
  destroyTeam(Club, false)
  freezeFinances(Club)
  hackTeamProfessionalism(Club, false, false)
  maxTacticalFamiliarity(Club, false)
  maxTeamCohesion(Club, false)
  removeTeamInjuries(Club, 10000, false)
  improveTeamCondition(Club, 10000, false)
  removeTeamBans(Club, false)

  More presets will add later
}
{$lua}
if syntaxcheck then return end
[ENABLE]
memrec.Color = Color.SwitchOn
memrec.Description = 'Freezer (On)'

if freezerItems == nil then
	freezerItems = {}
end

local _updateFunc = function()
  for _, v in pairs(freezerItems) do
    local Club = getAddressSafe(v.addr)
    if Club == nil or Club == 0 then return nil end

    if readInteger(Club+0xC) ~= v.uid then return end

    -- Preset 1
    if readBitInt(v.flag, 0) then
	    maxTacticalFamiliarity(Club, false)
    end
    -- Preset 2
    if readBitInt(v.flag, 1) then
	    maxTeamCohesion(Club, false)
    end
    -- Preset 3
    if readBitInt(v.flag, 2) then
	    destroyTeam(Club, false)
    end
    -- Preset 4
    if readBitInt(v.flag, 3) then
        local fitnessValue = 10000
	    removeTeamInjuries(Club, fitnessValue, false)
    end
    -- Preset 5
    if readBitInt(v.flag, 4) then
	    removeTeamBans(Club, false)
    end
    -- Preset 6
    if readBitInt(v.flag, 5) then
	    clubNoTransferActivity(Club, false)
    end
    -- Preset 7
    if readBitInt(v.flag, 6) then
	    freezeFinances(Club)
    end
    -- Preset 8
    if readBitInt(v.flag, 7) then
	    hackTeamProfessionalism(Club, false, false)
    end
  end
end

enableTimer(memrec, 1000, _updateFunc)
[DISABLE]
memrec.Color = Color.SwitchOff
memrec.Description = 'Freezer (Off)'
</AssemblerScript>
            </CheatEntry>
            <CheatEntry>
              <ID>19910</ID>
              <Description>"----------------------------------------------------------------------------------------------------------------------------------"</Description>
              <Options moHideChildren="1" moDeactivateChildrenAsWell="1"/>
              <ShowAsHex>1</ShowAsHex>
              <Color>555555</Color>
              <GroupHeader>1</GroupHeader>
            </CheatEntry>
          </CheatEntries>
        </CheatEntry>
        <CheatEntry>
          <ID>19861</ID>
          <Description>"Database List &gt;"</Description>
          <Options moHideChildren="1"/>
          <Color>C080FF</Color>
          <GroupHeader>1</GroupHeader>
          <CheatEntries>
            <CheatEntry>
              <ID>13203</ID>
              <Description>"Agreement &gt;"</Description>
              <Color>FFFF00</Color>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>{$lua}
if syntaxcheck then return end
[ENABLE]
listAgreements(memrec)
[DISABLE]
