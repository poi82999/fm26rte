        <CheatEntry>
          <ID>2000</ID>
          <Description>"Person &gt;"</Description>
          <Options moHideChildren="1" moDeactivateChildrenAsWell="1"/>
          <Color>FF8080</Color>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>{$lua}
if syntaxcheck then return end
local Rpfc = getAddressList().getMemoryRecordByID(177) 	 -- Full Contract
local Rplc = getAddressList().getMemoryRecordByID(12122) -- Loan Contract
local Rpbc = getAddressList().getMemoryRecordByID(12639) -- B Club Contract
local Rpnc = getAddressList().getMemoryRecordByID(12906) -- Nation Contract
local Rprl = getAddressList().getMemoryRecordByID(11071) -- Relationships
local Rphg = getAddressList().getMemoryRecordByID(20100) -- Eligibility
local Rpst = getAddressList().getMemoryRecordByID(20109) -- Status
local Pcpl = getAddressList().getMemoryRecordByID(22739) -- Career Plans
local Nptd = getAddressList().getMemoryRecordByID(12620) -- Tendencies
local Pdcn = getAddressList().getMemoryRecordByID(18072) -- Days At Club/In Nation
local PErt = getAddressList().getMemoryRecordByID(17826) -- Player's Retirement
local PTnm = getAddressList().getMemoryRecordByID(23644) -- Player's Personality
local PTrf = getAddressList().getMemoryRecordByID(16863) -- Person Transfer
local PsKL = getAddressList().getMemoryRecordByID(24053) -- Scouting Knowledge
local PElg = getAddressList().getMemoryRecordByID(24077) -- Languages
local Pccb = getAddressList().getMemoryRecordByID(11331) -- Bonuses &amp; Clauses
local Ragt = getAddressList().getMemoryRecordByID(24375) -- Agent

[ENABLE]
local _updateName = function()
  local object = readQword('ptrPerson')
  if object == nil or object == 0 then memrec.Description = "Person &gt; &lt;N/A&gt;" return end

  local name = getObjectName(object)
  local uid = readInteger(object+objo.Duni)

  memrec.Description = string.format("Person &gt; %s (ID: %d)", name, uid)
  ---
  calculateRCA('ptrRCA')
  PTnm.Value = -1
  PTnm.Color = Color.Text
  getPersonPersonality(PTnm, 'ptrRCA+4')
  PErt.Address = getPersonRetirementDate(object)
  ---
  local Pfcc = getObjectName('[[[[ptrPerson]+pero.Pflc]+pero.Pcti]+teao.Tclu]')
  if Pfcc ~= nil then
	  Rpfc.Description = string.format("Full Contract &gt; Contracted to %s", Pfcc)
  else
	  Rpfc.Description = "Full Contract &gt;"
  end
  ---
  local Plcc = getObjectName('[[[[[ptrPerson]+pero.Potc]]+pero.Pcti]+teao.Tclu]')
  if Plcc ~= nil then
	  Rplc.Description = string.format("Loan Contract &gt; Loaned to %s", Plcc)
  else
	  Rplc.Description = "Loan Contract &gt;"
  end
  ---
  local Pbcc = getObjectName('[[[[[ptrPerson]+pero.Potc]+pero.Pbcc]+pero.Pcti]+teao.Tclu]')
  if Pbcc ~= nil then
	  Rpbc.Description = string.format("B Club Contract &gt; Available for %s", Pbcc)
  else
	  Rpbc.Description = "B Club Contract &gt;"
  end
  ---
  local Pncc = getObjectName('[[[[[ptrPerson]+pero.Potc]+pero.Pnac]+pero.Pcti]+teao.Tclu]')
  if Pncc ~= nil then
	  Rpnc.Description = string.format("Nation Contract &gt; Contracted to %s", Pncc)
  else
	  Rpnc.Description = "Nation Contract &gt;"
  end
  ---
  local Pagt = getObjectName('[[ptrPerson]+pero.Pagt]')
  if Pagt ~= nil then
	  Ragt.Description = string.format("Agent &gt; %s", Pagt)
  else
	  Ragt.Description = "Agent &gt;"
  end
  ---
  updatePlayerClauseRecords(memrec)
  PElg.Address = 1
  PTrf.Address = 1
  Nptd.Address = 1
  PsKL.Address = 1
  Pccb.Address = 1
  ---
  if Rprl.Active then
	  enablePersonRelationships(2)
  end
  if Rphg.Active then
	  enablePlayerEligibility(2)
  end
  if Rpst.Active then
	  enablePersonStatus()
  end
  if Pdcn.Active then
	  enableDaysAtClubInNation()
  end
  if Pcpl.Active then
	  enablePersonCareerPlans(2)
  end
end

local _updateFunc = function()
  if memrec ~= nil and memrec.Active then
	if readInteger('updPerson') == 1 then
	  writeInteger('updPerson', 0)
	  _updateName()
	end
  end
end

_updateName()
memrec.Color = Color.SwitchOn
enableTimer(memrec, Table.HeaderUpdateTime, _updateFunc)

[DISABLE]
memrec.Color = Color.Header
if memrec ~= nil then
  memrec.Description = "Person &gt;"
end

Rpfc.Description = "Full Contract &gt;"
Rplc.Description = "Loan Contract &gt;"
Rpbc.Description = "B Club Contract &gt;"
Rpnc.Description = "Nation Contract &gt;"
Ragt.Description = "Agent &gt;"
</AssemblerScript>
