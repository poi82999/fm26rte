                  <CheatEntries>
                    <CheatEntry>
                      <ID>12524</ID>
                      <Description>"Generate a DOF"</Description>
                      <Color>DCDCDC</Color>
                      <VariableType>Auto Assembler Script</VariableType>
                      <AssemblerScript>{$lua}
if syntaxcheck then return end
[ENABLE]
local function _updateFunc()
  local Person = readQword('ptrPerson')
  if Person == nil or Person == 0 or not isStaff(Person) then return end

  -- Job Preferences
  getAddressList().getMemoryRecordByID(1703).Value = 20                        -- Director of Football
  getAddressList().getMemoryRecordByID(1705).Value = 10                        -- Technical Director
  getAddressList().getMemoryRecordByID(1683).Value = 1                         -- Manager
  getAddressList().getMemoryRecordByID(1711).Value = 1                         -- Ast. Manager
  getAddressList().getMemoryRecordByID(1710).Value = 1                         -- Coach
  getAddressList().getMemoryRecordByID(1709).Value = 1                         -- Fitness Coach
  getAddressList().getMemoryRecordByID(1708).Value = 1                         -- GK Coach
  getAddressList().getMemoryRecordByID(1702).Value = 1                         -- Head of Youth Development
  getAddressList().getMemoryRecordByID(1706).Value = 10                        -- Scout
  getAddressList().getMemoryRecordByID(12486).Value = 1                        -- Data Analyst
  getAddressList().getMemoryRecordByID(1707).Value = 1                         -- Loan Manager
  getAddressList().getMemoryRecordByID(12485).Value = 1                        -- Physio
  getAddressList().getMemoryRecordByID(1704).Value = 1                         -- Sport Scientist
  getAddressList().getMemoryRecordByID(1701).Value = 1                         -- Chairman
  -- Non Player General
  getAddressList().getMemoryRecordByID(11176).Value = 0                        -- Coaching Style
  getAddressList().getMemoryRecordByID(11177).Value = 0                        -- Coaching License
  -- Non Player Coaching Attributes
  getAddressList().getMemoryRecordByID(11200).Value = 1                        -- Attacking
  getAddressList().getMemoryRecordByID(11201).Value = 1                        -- Defending
  getAddressList().getMemoryRecordByID(11202).Value = 1                        -- Fitness
  getAddressList().getMemoryRecordByID(11206).Value = 1                        -- Mental
  getAddressList().getMemoryRecordByID(11208).Value = 1                        -- Tactical
  getAddressList().getMemoryRecordByID(11209).Value = 1                        -- Technical
  getAddressList().getMemoryRecordByID(11199).Value = math.random(12,20)       -- Working w/ Youngster
  getAddressList().getMemoryRecordByID(12466).Value = 1                        -- GK Handling
  getAddressList().getMemoryRecordByID(12465).Value = 1                        -- GK Distribution
  getAddressList().getMemoryRecordByID(12467).Value = 1                        -- GK Shot Stopping
  -- Non Player Mental Attributes
  getAddressList().getMemoryRecordByID(11214).Value = math.random(15,20)       -- Adaptability
  if (tonumber(getAddressList().getMemoryRecordByID(11216).Value) &lt; 13) then
     getAddressList().getMemoryRecordByID(11216).Value = math.random(12,14)    -- Determination
  end
  getAddressList().getMemoryRecordByID(11215).Value = math.random(12,14)       -- Level of Discipline
  getAddressList().getMemoryRecordByID(11210).Value = math.random(12,14)       -- Man Management
  getAddressList().getMemoryRecordByID(11219).Value = math.random(12,14)       -- Motivating
  -- Non Player Knowledge Attributes
  getAddressList().getMemoryRecordByID(12446).Value = math.random(12,14)       -- Judging Staff Ability
  getAddressList().getMemoryRecordByID(12451).Value = math.random(13,20)       -- Negotiating
  getAddressList().getMemoryRecordByID(12448).Value = math.random(12,16)       -- Tactical Knowledge
  if (tonumber(getAddressList().getMemoryRecordByID(11199).Value) &lt;= 15) then
	  getAddressList().getMemoryRecordByID(12444).Value = math.random(18,20)   -- Judging Player Ability
	  getAddressList().getMemoryRecordByID(12445).Value = math.random(12,18)   -- Judging Player Potential
  else
	  getAddressList().getMemoryRecordByID(12444).Value = math.random(12,18)   -- Judging Player Ability
	  getAddressList().getMemoryRecordByID(12445).Value = math.random(18,20)   -- Judging Player Potential
  end
  -- Non Player Medical Attributes
  getAddressList().getMemoryRecordByID(12459).Value = 1                        -- Physiotherapy
  getAddressList().getMemoryRecordByID(12460).Value = 1                        -- Sports Science
  -- Non Player Analyst Attributes
  getAddressList().getMemoryRecordByID(11229).Value = 1                        -- Analysing Data
  -- Non Player Chairman Attributes
  getAddressList().getMemoryRecordByID(11224).Value = 1                        -- Business
  getAddressList().getMemoryRecordByID(11225).Value = 1                        -- Interference
  getAddressList().getMemoryRecordByID(11226).Value = 1                        -- Patience
  getAddressList().getMemoryRecordByID(11227).Value = 1                        -- Resources
  -- Non Player Non Tactical Attributes
  getAddressList().getMemoryRecordByID(11194).Value = math.random(15,20)       -- Buying Players
  getAddressList().getMemoryRecordByID(11195).Value = math.random(5,20)        -- Hardness Of Training
  getAddressList().getMemoryRecordByID(11196).Value = math.random(5,20)        -- Mind Games
  getAddressList().getMemoryRecordByID(11197).Value = math.random(5,20)        -- Squad Rotation
  getAddressList().getMemoryRecordByID(11212).Value = math.random(5,20)        -- Versatility
end

_updateFunc()
enableAutoDisable(memrec, nil) 
[DISABLE]
</AssemblerScript>
