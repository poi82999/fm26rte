          <ID>1000</ID>
          <Description>"Club &gt;"</Description>
          <Options moHideChildren="1" moDeactivateChildrenAsWell="1"/>
          <Color>FF8080</Color>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>{$lua}
if syntaxcheck then return end
[ENABLE]
local C1sq = getAddressList().getMemoryRecordByID(1010)  -- Teams
local Cafl = getAddressList().getMemoryRecordByID(12885) -- Club Affiliations
local TCrs = getAddressList().getMemoryRecordByID(13041) -- Responsibilities
local Coin = getAddressList().getMemoryRecordByID(12910) -- Sponsorship
local Cdbt = getAddressList().getMemoryRecordByID(23744) -- Debts
local Cbdr = getAddressList().getMemoryRecordByID(23773) -- Board Requests
local CAmb = getAddressList().getMemoryRecordByID(24003) -- Objectives
local Cnec = getAddressList().getMemoryRecordByID(24000) -- Relationships
local Ctcd = getAddressList().getMemoryRecordByID(23815) -- Training Camp
local Cdri = getAddressList().getMemoryRecordByID(13042) -- Board Members
local Cphi = getAddressList().getMemoryRecordByID(1011) -- Medical Team
local Cchi = getAddressList().getMemoryRecordByID(1012) -- Coaching Team
local Csci = getAddressList().getMemoryRecordByID(1013) -- Recruitment Team

local _updateName = function()
  local object = readQword('ptrClub')
  if object == nil or object == 0 then memrec.Description = "Club &gt; &lt;N/A&gt;" return end

  local name = getObjectName(object)
  local uid = readInteger(object+objo.Duni)

  memrec.Description = string.format("Club &gt; %s (ID: %d)", name, uid)
  ---
  if C1sq.Active then
	  enableTeamRecords(C1sq, 'ptrClub')
  end
  if Cdri.Active then
      enablePersonArray(Cdri, 'Board Members', '[[ptrClub]+110]', '[[ptrClub]+110]+8')
  end
  if Cphi.Active then
      enablePersonArray(Cphi, 'Medical Team', '[ptrClub]+60', '[ptrClub]+68')
  end
  if Cchi.Active then
      enablePersonArray(Cchi, 'Coaching Staff', '[ptrClub]+78', '[ptrClub]+80')
  end
  if Csci.Active then
      enablePersonArray(Csci, 'Recruitment Staff', '[ptrClub]+90', '[ptrClub]+98')
  end
  if Cafl.Active then
	  enableClubAffiliationsRecords(2)
  end
  if TCrs.Active then
	  enableResponsibilityRecords(TCrs, 'ptrClub')
  end
  if Coin.Active then
	  enableClubSponsorshipRecords(2)
  end
  if Cdbt.Active then
	  enableClubDebtLoanRecords()
  end
  if Cbdr.Active then
	  enableBoardRequests(Cbdr, 'ptrClub')
  end
  if CAmb.Active then
	  enableClubVisions()
  end
  if Cnec.Active then
	  enableClubRelationships()
  end
  if Ctcd.Active then
	  enableTrainingCamp(Ctcd, 'ptrClub')
  end
end

local _updateFunc = function()
  if memrec ~= nil and memrec.Active then
	if readInteger('updClub') == 1 then
	  writeInteger('updClub', 0)
	  _updateName()
	end
  end
end

_updateName()
memrec.Color = Color.SwitchOn
enableTimer(memrec, Table.HeaderUpdateTime, _updateFunc)

[DISABLE]
memrec.Color = Color.Header
if memrec ~= nil then
  memrec.Description = "Club &gt;"
end
</AssemblerScript>
