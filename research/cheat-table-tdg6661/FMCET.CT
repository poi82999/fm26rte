[ENABLE]
local function _updateFunc()
  local Person = readQword('ptrPerson')
  if Person == nil or Person == 0 or not isPerson(Person) then return end

  local perc = tonumber(inputQuery("Enter Value","Percentage (1-99):",""))
  if not isnumber(perc) or perc &lt; 1 or perc &gt; 99 then return end

  return cutPersonWage('ptrPerson', perc)
end

