            <CheatEntry>
              <ID>17843</ID>
              <Description>"Ignore Player Retirement"</Description>
              <Options moHideChildren="1" moDeactivateChildrenAsWell="1"/>
              <Color>0F0F0F</Color>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>{$lua}
if syntaxcheck then return end
[ENABLE]
local symbol = 'ignoreRet'
customAlloc(symbol, 0x8)
symbol = getAddressSafe(symbol)

local UID = mgrClubUID
writeInteger(symbol+0x2, UID)
writeByte(symbol, 32)
writeByte(symbol+0x1, 170)

local odesc = memrec.description
local desc = string.format('%s [Please wait....]',odesc)

memrec.description = desc

local _updateFunc = function()
  local addr = getAddressSafe('ignoreRet')
  if addr == nil or addr == 0 then return end

  memrec.description = odesc

  ignoreRetStartAge = readByte(addr)
  ignoreRetStartPA  = readByte(addr+0x1)
  ignoreRetCUID     = readInteger(addr+0x2)
end

enableTimer(memrec, Table.TimerUpdateTime, _updateFunc)
[DISABLE]
deAlloc('ignoreRet')
unregisterSymbol('ignoreRet')

</AssemblerScript>
