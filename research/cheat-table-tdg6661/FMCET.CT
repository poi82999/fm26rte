        <CheatEntry>
          <ID>4000</ID>
          <Description>"Competition &gt;"</Description>
          <Options moHideChildren="1" moDeactivateChildrenAsWell="1"/>
          <Color>FF8080</Color>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>{$lua}
if syntaxcheck then return end
[ENABLE]
local Cltb = getAddressList().getMemoryRecordByID(18064)  -- League Table
local Cslp = getAddressList().getMemoryRecordByID(12681)  -- Prize Money

local _updateName = function()
  local object = readQword('ptrComp')
  if object == nil or object == 0 then memrec.Description = "Competition &gt; &lt;N/A&gt;" return end

  local name = getObjectName(object)
  local uid = readInteger(object+objo.Duni)

  memrec.Description = string.format("Competition &gt; %s (ID: %d)", name, uid)
  ---
  Cltb.Address = 1
  Cslp.Address = 1
end

local _updateFunc = function()
  if memrec ~= nil and memrec.Active then
	if readInteger('updComp') == 1 then
	  writeInteger('updComp', 0)
	  _updateName()
	end
  end
end

_updateName()
memrec.Color = Color.SwitchOn
enableTimer(memrec, Table.HeaderUpdateTime, _updateFunc)

[DISABLE]
memrec.Color = Color.Header
if memrec ~= nil then
  memrec.Description = "Competition &gt;"
end
</AssemblerScript>
