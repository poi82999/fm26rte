local function _updateFunc()
  local Club = readQword('ptrClub')
  if Club == nil or Club == 0 or not isClub(Club) then return end

  local rec1 = getAddressList().getMemoryRecordByID(11601)
  local rec2 = getAddressList().getMemoryRecordByID(24197)
  local rec3 = getAddressList().getMemoryRecordByID(11602)
  local rec4 = getAddressList().getMemoryRecordByID(24148)

  for i = 0, (rec1.Count-1) do
    if rec1.Child[i].Value ~= nil then
      rec1.Child[i].Value = 0
    end
  end

  for i = 0, (rec2.Count-1) do
    if rec2.Child[i].Value ~= nil then
      rec2.Child[i].Value = 0
    end
  end

  for i = 0, (rec3.Count-1) do
    if rec3.Child[i].Value ~= nil then
      rec3.Child[i].Value = 0
    end
  end

  for i = 0, (rec4.Count-1) do
    if rec4.Child[i].Value ~= nil then
      rec4.Child[i].Value = 0
    end
  end
end

_updateFunc()
enableAutoDisable(memrec, nil) 
