            <CheatEntry>
              <ID>20096</ID>
              <Description>"Talented Regens"</Description>
              <Color>DCDCDC</Color>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>{$lua}
if syntaxcheck then return end
[ENABLE]
local _updateFunc = function()
  local startPA = tonumber(inputQuery("Enter Value","Start PA (1-200):",""))
  if not isnumber(startPA) or startPA &lt; 1 or startPA &gt; 200 then return end

  local count = 0

  cls()
  print('List of Talented Regens:\r\n')
  print(string.format('%-32s \t %-24s \t %s \t %s \t %s \t\t %s','Name','Unique ID','Age','Nat','CA/PA','Club'))
  print('----------------------------------------------------------------------------------------------------------------------------------')
  forEach(PersonTableStart, PersonTableEnd, 0x8, function(k, elemAddr)
    if count+1 &gt; Table.MaxShowItem then return end

    local Person = readQword(elemAddr)
    if Person == nil or Person == 0 or not isPlayer(Person) then return end

    local Player = getPlayerFromPerson(Person)
    if Player == nil or Player == 0 then return end

    local UID = readInteger(Person+objo.Duni)
    if UID &lt; 2002068000 then return end

    local CA = readSmallInteger(Player+plao.Pcab)
    local PA = readSmallInteger(Player+plao.Ppab)

    if PA &lt; startPA then return end -- Filter: PA

    local DOB = getAddressSafe(Person+pero.Pdob)
    local DOBDay = bAnd(readSmallInteger(DOB), 0x1FF)
    local DOBYear = readSmallInteger(DOB+0x2)

    local Age = getAge(DOBDay, DOBYear)

    if Age &gt; 23 then return end -- Filter: Max Age

    local Name = getObjectName(Person)
    local Club = getObjectName(getPersonClub(Person))

    -- Uncomment to search free transfer players
    --if Club ~= nil then return end -- Filter: Free Transfer

    if Club == nil then Club = 'Free Transfer' end

    if #Name &lt; 16 then
      print(string.format('%-32s \t %d \t %d \t %s \t %d/%d \t\t %s', Name, UID, Age, getNationThreeLetterName(readQword(Person+0x70)), CA, PA, Club))
    else
      print(string.format('%-28s \t %d \t %d \t %s \t %d/%d \t\t %s', Name, UID, Age, getNationThreeLetterName(readQword(Person+0x70)), CA, PA, Club))
    end
    count = count + 1
  end)
  print('----------------------------------------------------------------------------------------------------------------------------------')
  print('\nTotal:', count)

end

_updateFunc()
enableAutoDisable(memrec, nil) 
[DISABLE]
</AssemblerScript>
