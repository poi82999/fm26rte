{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FM26 선수 에디터",
  "version": "0.1.0",
  "identifier": "dev.fm26rte.playereditor",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "FM26 선수 에디터",
        "width": 1180,
        "height": 760,
        "minWidth": 1100,
        "minHeight": 720
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "nsis"
  }
}
